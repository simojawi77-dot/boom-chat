{
  "name": "boom_chat",
  "private": true,
  "scripts": {
    "dev": "docker compose up --build",
    "dev:down": "docker compose down -v",
    "dev:local": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}